{
  "name": "moudarir/file-manager",
  "description": "A PHP library for managing file upload, image resize, cropping, convert and watermark.",
  "type": "library",
  "homepage": "https://github.com/moudarir/file-manager",
  "license": "MIT",
  "keywords": [
    "file-manager",
    "upload",
    "resize",
    "crop",
    "convert",
    "Watermark",
    "collection",
    "php"
  ],
  "authors": [
    {
      "name": "Abdessamad MOUDARIR",
      "email": "amoudarir@gmail.com"
    }
  ],
  "support": {
    "issues": "https://github.com/moudarir/file-manager/issues",
    "source": "https://github.com/moudarir/file-manager"
  },
  "require": {
    "php": ">=8.4",
    "moudarir/file": "^1.0",
    "moudarir/helpers": "^1.3"
  },
  "autoload": {
    "psr-4" : {
      "Moudarir\\FileManager\\": "src/"
    }
  },
  "require-dev": {
    "phpunit/phpunit": "^13.0"
  },
  "autoload-dev": {
    "psr-4": {
      "Moudarir\\FileManager\\Tests\\": "tests/"
    }
  },
  "scripts": {
    "server-start": "bash examples/server-start.sh",
    "server-stop": "bash examples/server-stop.sh",
    "test": "phpunit tests/Unit"
  }
}
